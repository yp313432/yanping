{
  "name": "yanping-health-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --env production --outdir dist",
    "build:test": "wrangler deploy --dry-run --config test/wrangler.jsonc --outdir ../dist-test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/neon.test.ts test/worker.test.mjs",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.1"
  },
  "devDependencies": {
    "@types/node": "22.16.5",
    "typescript": "5.9.3",
    "wrangler": "4.131.0"
  }
}
